# 模块仓库(setup.sh clone 进来的独立 git 仓库,不属于本仓)
# ⚠️ 必须**与 CI 的检出形态一致**:train-orchestrator 把 15 个生态仓 clone 进
# hub 根目录(charts/ desktop/ 也在内)⇒ 漏掉任何一个,CI 侧检出闸就恒红
# (2026-11-17 实录:漏 /desktop/ 与 /charts/ ⇒ 5.9.0 首跑死在检出闸)。
/contracts/
/core/
/server/
/frontend/
/frontend-core/
/fnos/
/openwrt/
/p2p/
/kit/
/desktop/
/charts/

# Go 构建产物
# 根锚定（/）：只忽略仓根的构建/运行时目录。早前写成 data/ 会连带命中任意
# 层级同名目录——docs-site/.vitepress/theme/data/ 曾被静默吞掉（CI 构建才暴露：
# "Could not resolve ../data/features"），故一律锚到仓根。
/bin/
/data/
/logs/
*.log
.DS_Store

# compose 本地环境配置(含密钥,勿提交)
.env
/synology/
/qnap/
/ugreen/
/terramaster/

# 工具运行时目录(非本仓产物,勿提交)
.video_agent/

# 跨仓 worktree 目录(模块仓的 git worktree 寄放在仓根,非本仓产物;train-preflight
# 检出闸要求工作树干净,不忽略会永久挡发车)——根锚定,只忽略仓根
/core-worktrees/
/core-wt-*/
/fix-issues-*/

# Python 字节码（scripts/*.py 本地 py_compile 产物）
__pycache__/
*.pyc

# 错误码跨版本断言的**临时素材目录**（已发布 frontend-core 的 tgz 与解包产物；
# 由 CI step 与本地复跑现场下载/解包，不是本仓产物）
/.tmp-materials/
/.tmp-errcode-xver/
