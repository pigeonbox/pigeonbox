# PigeonBox NAS 部署配置（安装包自动生成，可手工修改；改后 docker compose up -d 生效）

# ── 常用 ─────────────────────────────────────────────────────────
# 镜像版本：升级时改成新版本 tag（与 github.com/pigeonbox/server/releases 对齐）
PB_IMAGE_TAG=1.22.0
# 时区
TZ=Asia/Shanghai
# 对外端口与监听地址（NAS 上改端口只动这里；改后需放行 NAS 防火墙）
PB_API_PORT=12345
PB_API_BIND=0.0.0.0
# 数据目录（安装时自动写入绝对路径；SQLite + 上传文件 + JWT 密钥都在这里）
PB_DATA_DIR=
# 管理员密码（**必填**：本部署 PB_PRODUCTION=1，留空 = 容器拒绝启动——安全默认，防 admin/admin123 弱口令上线）
PB_ADMIN_PASSWORD=

# ── 站点行为 ─────────────────────────────────────────────────────
# 对外完整地址（有域名/HTTPS 反代时填，如 https://files.example.com，分享链接会用它）
PB_SERVER_BASE_URL=
# 开放注册（NAS 场景默认关闭、管理员建号；个人自用建议保持 false）
PB_USER_ALLOW_REGISTRATION=false
# 请求体大小上限（nginx 反代层；分片上传不受影响）
PB_MAX_BODY_SIZE=1024m

# ── 高级 ─────────────────────────────────────────────────────────
# JWT 密钥（留空 = 数据目录自动生成持久化；显式设置则轮换后旧会话全部失效）
PB_JWT_SECRET=
# 可信代理 CIDR（逗号分隔；套 HTTPS 网关/反代时必填，否则限流按代理 IP 计数）
PB_TRUSTED_PROXIES=
# Redis（默认单机内存模式；启用 compose 内 redis 服务段后设为 redis）
PB_REDIS_HOST=
