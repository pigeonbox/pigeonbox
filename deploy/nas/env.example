# PigeonBox NAS 部署配置（安装包自动生成，可手工修改；改后 docker compose up -d 生效）

# ── 常用 ─────────────────────────────────────────────────────────
# 镜像版本：升级时改成新版本 tag（与 github.com/pigeonbox/server/releases 对齐）
PB_IMAGE_TAG=3.3.16
# 时区
TZ=Asia/Shanghai
# 对外端口与监听地址（NAS 上改端口只动这里；改后需放行 NAS 防火墙）
PB_API_PORT=12345
PB_API_BIND=0.0.0.0
# 数据目录（安装时自动写入绝对路径；SQLite + 上传文件 + JWT 密钥都在这里）
PB_DATA_DIR=
# 管理员密码。留空 = 不播种弱口令 admin/admin123，改走 /setup 首启向导：
# 浏览器打开 http://<NAS_IP>:12345 走完即建号（2026-10-22 起全生态统一，与 openwrt/qnap 同款）。
# 弱口令可被扫描器猜到；未初始化实例要有人刻意访问 /setup 才能认领——后者暴露面小得多。
# 已配密码则照常播种 admin（首次安装更省事）。
PB_ADMIN_PASSWORD=
# 首启令牌（可选，公网部署建议设）。留空 = 首启建号页不校验令牌；
# 设任意非空值后，建号必须带上它（未带/带错按 IP 锁定 10 分钟）。
# 为什么需要：未初始化实例的 /setup 无鉴权——谁先访问谁建号（setup-race）。
# 内网自托管留空即可（零摩擦）；公网暴露的站点请设，收口暴露面。
# 建号完成后令牌即刻失效，可从本文件移除。
PB_SETUP_TOKEN=

# ── 站点行为 ─────────────────────────────────────────────────────
# 对外完整地址（有域名/HTTPS 反代时填，如 https://files.example.com，分享链接会用它）
PB_SERVER_BASE_URL=
# 开放注册（NAS 场景默认关闭、管理员建号；个人自用建议保持 false）
PB_USER_ALLOW_REGISTRATION=false
# 请求体大小上限（nginx 反代层；**物理防线,非业务上限**）
# 单文件上限在管理后台「上传设置」配置（服务端权威：presign init 阶段即拒超限文件）
# ⚠️ 本值必须 >= 服务端 upload.max_file_size,否则 nginx 会先拒成 413（业务上限形同虚设）
PB_MAX_BODY_SIZE=8192m

# ── 高级 ─────────────────────────────────────────────────────────
# JWT 密钥（留空 = 数据目录自动生成持久化；显式设置则轮换后旧会话全部失效）
PB_JWT_SECRET=
# 可信代理 CIDR（逗号分隔；套 HTTPS 网关/反代时必填，否则限流按代理 IP 计数）
PB_TRUSTED_PROXIES=
# Redis（默认单机内存模式；启用 compose 内 redis 服务段后设为 redis）
PB_REDIS_HOST=
